# Sensing Voxel - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Enable debug mode (default: false)
SV_DEBUG=false

# SearXNG instance secret. Generate one for .env, for example: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-random-secret

# =============================================================================
# TELEGRAM BOT (REQUIRED)
# =============================================================================

# Your Telegram bot token from @BotFather
SV_TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of allowed Telegram user IDs
# Get your user ID from @userinfobot
SV_TELEGRAM_ALLOWED_USERS=100000001

# =============================================================================
# DASHBOARD
# =============================================================================

# Enable web dashboard (default: true)
SV_DASHBOARD_ENABLED=true

# Dashboard port on host machine (default: 8080)
SV_DASHBOARD_PORT=8080

# Optional API token for Bearer authentication (leave empty for no auth)
SV_DASHBOARD_API_TOKEN=

# =============================================================================
# KLIPPER/MOONRAKER (Optional - uncomment if using Klipper)
# =============================================================================

# Moonraker host IP or hostname
# SV_KLIPPER_HOST=192.0.2.10

# Moonraker port (default: 7125)
# SV_KLIPPER_PORT=7125

# Moonraker API key (if authentication is enabled)
# SV_KLIPPER_API_KEY=your_api_key_here

# =============================================================================
# BAMBU PRINTER (Optional - uncomment if using Bambu)
# =============================================================================

# MQTT broker host (printer IP)
# SV_BAMBU_MQTT_HOST=192.0.2.11

# MQTT port (default: 1883 for Bambu)
# SV_BAMBU_MQTT_PORT=1883

# MQTT username (default: bblp for Bambu)
# SV_BAMBU_MQTT_USERNAME=bblp

# MQTT password (from printer settings)
# SV_BAMBU_MQTT_PASSWORD=your_mqtt_password

# FTP host (usually same as MQTT host)
# SV_BAMBU_FTP_HOST=192.0.2.11

# FTP port (default: 21)
# SV_BAMBU_FTP_PORT=21

# =============================================================================
# CAMERA (Optional - uncomment if using camera monitoring)
# =============================================================================

# RTSP URL for camera stream
# SV_CAMERA_RTSP_URL=rtsp://camera-user:camera-password@192.0.2.20:554/stream1

# Tapo C220 camera PTZ settings
# SV_TAPO_CAMERA_HOST=192.0.2.20
# SV_TAPO_CAMERA_USER=camera-user
# SV_TAPO_CAMERA_PASSWORD=replace-with-camera-password

# =============================================================================
# LLM/AI ASSISTANT (Optional - uncomment to enable AI chat)
# =============================================================================

# Enable LLM integration (default: false)
# SV_LLM_ENABLED=true

# API key for Anthropic Claude
# SV_LLM_API_KEY=your_anthropic_api_key

# Model to use (default: claude-sonnet-4-20250514)
# SV_LLM_MODEL=claude-sonnet-4-20250514
